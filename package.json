{
  "name": "@shanairai/ai-studio",
  "version": "0.1.0-alpha.0",
  "description": "A registry-driven declarative compiler for programmatic video: describe a video as data, compile it to a Remotion composition.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "keywords": [
    "remotion",
    "video",
    "compiler",
    "declarative",
    "templates",
    "react",
    "typescript"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js",
      "default": "./dist/lib.js"
    },
    "./inspect": {
      "types": "./dist/inspect.d.ts",
      "import": "./dist/inspect.js",
      "default": "./dist/inspect.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@remotion/google-fonts": "^4.0.489",
    "@remotion/transitions": "^4.0.489",
    "react": "^19.0.0",
    "remotion": "^4.0.489"
  },
  "peerDependenciesMeta": {
    "@remotion/google-fonts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@remotion/cli": "4.0.489",
    "@remotion/eslint-config-flat": "4.0.489",
    "@remotion/google-fonts": "4.0.489",
    "@remotion/tailwind-v4": "4.0.489",
    "@remotion/transitions": "4.0.489",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.489",
    "tailwindcss": "4.0.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "build:lib": "tsup",
    "prepack": "npm run build:lib",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "test": "vitest run",
    "test:typecheck": "tsc -p tsconfig.test.json",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run test:typecheck && npm run test"
  },
  "sideEffects": [
    "*.css",
    "**/config/fonts/bootstrap.ts"
  ]
}
